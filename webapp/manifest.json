{
  "_version": "1.5.0",
  "sap.app": {
    "id": "com.csr.salesdashboardsalesdashboard",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "45.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "sap/opu/odata/sap/ZPOSITIVE_REPORT_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "ui5template.basicSAPUI5ApplicationProject",
      "version": "1.40.12",
      "toolsId": "564fbe95-43a1-443e-982f-c7e6a3f7732c"
    },
    "crossNavigation": {
      "inbounds": {
        "salesdashboard-Display": {
          "semanticObject": "salesdashboard",
          "action": "Display",
          "title": "{{salesdashboard-Display.flpTitle}}",
          "icon": "sap-icon://monitor-payments",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "supportedThemes": [
      "sap_hcb",
      "sap_belize"
    ]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.csr.salesdashboardsalesdashboard.view.SalesDashboardMonth",
      "type": "XML"
    },
    "dependencies": {
      "minUI5Version": "1.30.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ushell": {},
        "sap.collaboration": {},
        "sap.ui.comp": {},
        "sap.uxap": {},
        "sap.ui.unified": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.csr.salesdashboardsalesdashboard.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.csr.salesdashboardsalesdashboard.view",
        "controlId": "idFullWidthAppControl",
        "controlAggregation": "pages",
        "clearTarget": false
      },
      "routes": [
        {
          "pattern": "",
          "name": "calViewMW",
          "target": [
            "calViewMW"
          ]
        },
        {
          "pattern": "calViewDay",
          "name": "calViewDay",
          "target": [
            "calViewMW",
            "calViewDay"
          ]
        }
      ],
      "targets": {
        "calViewMW": {
          "viewName": "SalesDashboardMonth",
          "viewLevel": 1
        },
        "calViewDay": {
          "viewName": "SalesDashboardDaily",
          "viewLevel": 2
        },
        "notFound": {
          "viewName": "NotFound",
          "viewId": "notFound"
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comcsrsalesdashboardsalesdashboard"
  },
  "sap.cloud.portal": {
    "salesdashboard-Display": {
      "vizType": "com.csr.customtilesalesreporttile"
    }
  }
}
